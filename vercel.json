{
  "buildCommand": "mkdir -p public && cp -r 'dejoiy.co.in main/public/.' public/",
  "outputDirectory": "public",
  "framework": null,
  "routes": [
    {
      "src": "/about/?",
      "dest": "/about.html"
    },
    {
      "src": "/services/?",
      "dest": "/services.html"
    },
    {
      "src": "/team/?",
      "dest": "/team.html"
    },
    {
      "src": "/contact/?",
      "dest": "/contact.html"
    },
    {
      "src": "/(about|services|team|contact)\\.html",
      "status": 301,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "/index\\.html",
      "status": 301,
      "headers": {
        "Location": "/"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}